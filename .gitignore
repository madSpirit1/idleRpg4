# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get large and are not useful for collaboration
/[Mm]emoryCaptures/

# Asset Packages
*.unitypackage

# Visual Studio files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/

# Gradle
.gradle/

# Autogenerated folder for Package Manager
/Packages/package-lock.json

# Image/Video snapshots
/Snapshot/

# AssetStore tools
/Assets/AssetStoreTools*

# Ignore all .meta files, EXCEPT for those that belong to a directory
# (This is a common, but sometimes controversial, approach)
# !*.meta

# Recommended: If you are using git LFS, uncomment the line below
# *.psd filter=lfs diff=lfs merge=lfs -text